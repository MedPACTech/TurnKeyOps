    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
    <PackageReference Include="AngleSharp" Version="1.4.0" />
    <PackageReference Include="Mime-Detective" Version="25.8.1" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.3" />
    <PackageReference Include="PDFiumSharpV2" Version="1.1.4" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="147.0.7699" />
    <PackageReference Include="bblanchon.PDFium.macOS" Version="147.0.7699" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.25.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurnKeyOps.AzureServices\TurnKeyOps.AzureServices.csproj" />
    <ProjectReference Include="..\TurnKeyOps.Lib\TurnKeyOps.Lib.csproj" />
    <ProjectReference Include="..\TurnKeyOps.Repositories\TurnKeyOps.Repositories.csproj" />
    <ProjectReference Include="..\Transcription.Core\Transcription.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
  <!-- Copy tessdata to build output and publish output -->
  <None Include="Tessdata\**\*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    <Pack>true</Pack>
    <PackagePath>Tessdata</PackagePath>
  </None>
</ItemGroup>

</Project>
