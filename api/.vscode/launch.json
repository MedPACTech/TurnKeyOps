{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (Development)",
      "type": "coreclr",
      "preLaunchTask": "build",
      "request": "launch",
      "program": "${workspaceFolder}/TurnKeyOps.API/bin/Debug/net10.0/TurnKeyOps.API.dll",
      "cwd": "${workspaceFolder}/TurnKeyOps.API",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5178;https://localhost:5001"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "Attach to .NET Functions",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:azureFunctions.pickProcess}"
    }
  ]
}
