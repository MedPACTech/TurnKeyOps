:\\\"assessment\\\",\\\"label\\\":\\\"Assessment\\\",\\\"sortOrder\\\":4,\\\"isRequired\\\":true,\\\"isEnabled\\\":true,\\\"promptInstructions\\\":\\\"Summarize the clinical impression and medical decision making clearly.\\\",\\\"outputTarget\\\":\\\"clinical_note\\\",\\\"communicationMode\\\":null},{\\\"key\\\":\\\"plan\\\",\\\"label\\\":\\\"Plan\\\",\\\"sortOrder\\\":5,\\\"isRequired\\\":true,\\\"isEnabled\\\":true,\\\"promptInstructions\\\":\\\"Include treatment decisions, medications, testing, referrals, return precautions, and follow-up.\\\",\\\"outputTarget\\\":\\\"clinical_note\\\",\\\"communicationMode\\\":null},{\\\"key\\\":\\\"billing_recommendations\\\",\\\"label\\\":\\\"Billing Recommendations\\\",\\\"sortOrder\\\":900,\\\"isRequired\\\":true,\\\"isEnabled\\\":true,\\\"promptInstructions\\\":\\\"Recommend billing codes only when supported by transcript evidence. If insufficient data exists, explicitly state what is missing.\\\",\\\"outputTarget\\\":\\\"billing_recommendations\\\",\\\"communicationMode\\\":null},{\\\"key\\\":\\\"external_communication\\\",\\\"label\\\":\\\"External Communication\\\",\\\"sortOrder\\\":1000,\\\"isRequired\\\":false,\\\"isEnabled\\\":false,\\\"promptInstructions\\\":\\\"Create patient-friendly communication with summary, options discussed, and next steps when this section is enabled.\\\",\\\"outputTarget\\\":\\\"external_communication\\\",\\\"communicationMode\\\":\\\"email\\\"}],\\\"tags\\\":[]}\",\"RequireTelehealthAttestation\":false,\"RequirePreventiveReview\":false,\"IsSystem\":true,\"IsDeleted\":false,\"CreatedBy\":\"system\",\"DateCreated@odata.type\":\"Edm.DateTime\",\"DateCreated\":\"2026-05-12T00:46:54.0337420Z\",\"UpdatedBy\":\"system\",\"DateUpdated@odata.type\":\"Edm.DateTime\",\"DateUpdated\":\"2026-05-12T00:46:54.0337630Z\",\"Timestamp\":\"2026-05-12T00:46:54.0345897Z\"},{\"odata.etag\":\"W/\\\"datetime'2026-05-12T00%3A46%3A54.0445998Z'\\\"\",\"PartitionKey\":\"NOTETYPEPROFILE|SYSTEM\",\"RowKey\":\"4d82742d-4731-46d6-b0de-f0e8e5885f55\",\"Type\":\"MedInsights.Lib.Entities.NoteTypeProfile\",\"Id@odata.type\":\"Edm.Guid\",\"Id\":\"4d82742d-4731-46d6-b0de-f0e8e5885f55\",\"NoteTypeId@odata.type\":\"Edm.Guid\",\"NoteTypeId\":\"4d82742d-4731-46d6-b0de-f0e8e5885f55\",\"RecordType\":\"Profile\",\"PromptInstructions\":\"Generate a focused follow-up note. Emphasize interval change since the last visit, treatment response, current status, and the updated plan. Keep the note concise and action-oriented.\",\"SectionSchemaJson\":\"{\\\"sections\\\":[{\\\"key\\\":\\\"interval_history\\\",\\\"label\\\":\\\"Interval History\\\",\\\"sortOrder\\\":1,\\\"isRequired\\\":true,\\\"isEnabled\\\":true,\\\"promptInstructions\\\":\\\"Describe changes since the last visit, including symptom progression, treatment response, adherence, and any new concerns.\\\",\\\"outputTarget\\\":\\\"clinical_note\\\",\\\"communicationMode\\\":null},{\\\"key\\\":\\\"exam\\\",\\\"label\\\":\\\"Exam\\\",\\\"sortOrder\\\":2,\\\"isRequired\\\":false,\\\"isEnabled\\\":true,\\\"promptInstructions\\\":\\\"Include updated pertinent exam findings when relevant to the follow-up problem.\\\",\\\"outputTarget\\\":\\\"clinical_note\\\",\\\"communicationMode\\\":null},{\\\"key\\\":\\\"assessment\\\",\\\"label\\\":\\\"Assessment\\\",\\\"sortOrder\\\":3,\\\"isRequired\\\":true,\\\"isEnabled\\\":true,\\\"promptInstructions\\\":\\\"Summarize current status, progress, and ongoing clinical impression.\\\",\\\"outputTarget\\\":\\\"clinical_note\\\",\\\"communicationMode\\\":null},{\\\"key\\\":\\\"plan\\\",\\\"label\\\":\\\"Plan\\\",\\\"sortOrder\\\":4,\\\"isRequired\\\":true,\\\"isEnabled\\\":true,\\\"promptInstructions\\\":\\\"Include medication changes, monitoring, testing, referrals, and follow-up timing.\\\",\\\"outputTarget\\\":\\\"clinical_note\\\",\\\"communicationMode\\\":null},{\\\"key\\\":\\\"billing_recommendations\\\",\\\"label\\\":\\\"Billing Recommendations\\\",\\\"sortOrder\\\":900,\\\"isRequired\\\":true,\\\"isEnabled\\